# Sao chép file này thành .env rồi sửa giá trị. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL. Docker: cổng 5432. Cài PostgreSQL trên Windows: xem cổng đã chọn lúc cài (thường 5432, có thể 5433).
DATABASE_URL="postgresql://khachsan:khachsan@localhost:5432/khachsan?schema=public"

# Cổng HTTP của backend
PORT=3000

# Địa chỉ web được gọi API (CORS), cách nhau dấu phẩy. Bỏ trống = cho mọi http://localhost:<cổng> khi dev.
# Khi triển khai: CORS_ORIGINS="https://ten-mien-demo.vn"
# CORS_ORIGINS=

# Ngưỡng quá hạn việc bảo trì, tính bằng phút. Bỏ trống = 240 (4 giờ — maintenance OQ-1 chốt 10/10/2026); 0 = tắt.
# MAINTENANCE_DUE_MINUTES=240

# Ảnh nghiệm thu dọn phòng: thư mục lưu (mặc định uploads/) và dung lượng tối đa mỗi ảnh tính bằng MB (mặc định 5).
# UPLOAD_DIR=uploads
# PHOTO_MAX_MB=5

# Tóm tắt vận hành bằng AI. Bỏ trống OPENAI_API_KEY = luôn dùng báo cáo mẫu (không gọi AI). KHÔNG commit khóa thật.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Ngân sách AI toàn MVP (VNĐ) và đơn giá theo model (VNĐ / 1 triệu token) — cập nhật khi đổi model.
# AI_BUDGET_VND=300000
# AI_PRICE_INPUT_VND_PER_1M=4000
# AI_PRICE_OUTPUT_VND_PER_1M=16000

# Mật khẩu chung cho các tài khoản mẫu khi chạy seed (chỉ dùng cho môi trường dev/demo)
SEED_PASSWORD="Demo@12345"

# (Tuỳ chọn) CSDL cho `npm test`. Bỏ trống → dùng tên DB ở DATABASE_URL + "_test" (tự tạo khi chạy test).
# TEST_DATABASE_URL="postgresql://khachsan:khachsan@localhost:5432/khachsan_test?schema=public"
